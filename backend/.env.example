# Railway's postgresql:// URL also works; the driver is rewritten to psycopg automatically.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/rainfall
APP_ENV=development
# Comma-separated list
CORS_ORIGINS=http://localhost:5173
PORT=8000
# Ingestion: first date loaded into an empty database, and recent days re-fetched each run.
INGEST_START_DATE=2025-01-01
INGEST_REFETCH_DAYS=10
# Days re-loaded from SMHI's corrected archive by --archive-refresh.
SMHI_ARCHIVE_REFRESH_DAYS=130
# MET Norway Frost API client ID (free: https://frost.met.no/auth/requestCredentials.html). Optional.
FROST_CLIENT_ID=
# Address agents are told to use (MCP at <this>/mcp).
PUBLIC_BASE_URL=https://rainfall-production.up.railway.app
# Traffic limits (see README). MCP tool calls per session / IP / in total, REST requests per IP.
MCP_SESSION_PER_MINUTE=60
MCP_SESSION_PER_DAY=1500
MCP_IP_PER_MINUTE=60
MCP_TRUSTED_IP_PER_MINUTE=1000
MCP_TRUSTED_IP_RANGES=160.79.104.0/21
MCP_GLOBAL_PER_MINUTE=1200
MCP_PAUSE_MINUTES=15
REST_IP_PER_MINUTE=300
STATEMENT_TIMEOUT_MS=10000
