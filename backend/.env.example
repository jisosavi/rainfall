# Railway's postgresql:// URL also works; the driver is rewritten to psycopg automatically.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/rainfall
APP_ENV=development
# Comma-separated list
CORS_ORIGINS=http://localhost:5173
PORT=8000
# Ingestion: first date loaded into an empty database, and recent days re-fetched each run.
INGEST_START_DATE=2025-01-01
INGEST_REFETCH_DAYS=10
# Days re-loaded from SMHI's corrected archive by --archive-refresh.
SMHI_ARCHIVE_REFRESH_DAYS=130
# MET Norway Frost API client ID (free: https://frost.met.no/auth/requestCredentials.html). Optional.
FROST_CLIENT_ID=
