# Copy to .env.local to override locally.
# Backend URL for builds; in `npm run dev` requests go through the /api proxy instead.
VITE_API_URL=https://rainfall-production.up.railway.app
# Path the site is served from.
VITE_BASE=/test/rainfall/
# Backend the dev server proxies /api to, e.g. http://localhost:8000
DEV_API_PROXY=https://rainfall-production.up.railway.app
